@page "/movies"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Movies</PageTitle>

<h1>Movies</h1>

@if (movies is null)
{
    <p><em>Loading movies...</em></p>
}
else if (!movies.Any())
{
    <p>No movies found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Year</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in movies)
            {
                <tr>
                    <td>@movie.Id</td>
                    <td>@movie.Title</td>
                    <td>@movie.Year</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Movie>? movies;

    protected override async Task OnInitializedAsync()
    {
        movies = await Http.GetFromJsonAsync<List<Movie>>("http://localhost:5000/api/movie");
    }
}
