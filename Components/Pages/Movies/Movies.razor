@using Radzen
@using Radzen.Blazor

@page "/movies"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Movies</PageTitle>

<h1>Movies</h1>

@if (movies is null)
{
    <p><em>Loading movies...</em></p>
}
else if (!movies.Any())
{
    <p>No movies found.</p>
}
else
{
    <RadzenDataGrid 
        Data="@movies" 
        TItem="Movie"
        AllowSorting="true">
        
        <Columns>
            <RadzenDataGridColumn TItem="Movie" Property="Id" Title="Id" />
            <RadzenDataGridColumn TItem="Movie" Property="Title" Title="Title" />
            <RadzenDataGridColumn TItem="Movie" Property="Year" Title="Year" />
        </Columns>
    </RadzenDataGrid>
}

@code {
    private List<Movie>? movies;

    protected override async Task OnInitializedAsync()
    {
        movies = await Http.GetFromJsonAsync<List<Movie>>("http://localhost:5000/api/movie");
    }
}
